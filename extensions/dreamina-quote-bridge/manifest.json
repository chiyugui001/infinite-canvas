{
  "manifest_version": 3,
  "name": "Infinite Canvas · 即梦实时报价桥",
  "version": "0.2.0",
  "description": "只读同步即梦网页显示的生成积分，不包含生成或提交能力。",
  "key": "",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://jimeng.jianying.com/*",
    "http://127.0.0.1:17371/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "即梦实时报价桥", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://jimeng.jianying.com/ai-tool/generate*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
